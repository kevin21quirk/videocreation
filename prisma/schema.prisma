generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String        @id @default(cuid())
  title       String
  quote       String        @db.Text
  description String        @db.Text
  script      String?       @db.Text
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assets Asset[]
  videos GeneratedVideo[]

  @@map("projects")
}

model Asset {
  id        String    @id @default(cuid())
  projectId String
  fileName  String
  fileUrl   String
  fileType  AssetType
  fileSize  Int
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model GeneratedVideo {
  id           String      @id @default(cuid())
  projectId    String
  didTalkId    String?
  videoUrl     String?
  thumbnailUrl String?
  status       VideoStatus @default(PENDING)
  errorMessage String?
  duration     Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("generated_videos")
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
}
